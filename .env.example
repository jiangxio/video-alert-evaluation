# AI 助手配置
# 复制本文件为 .env 并填入真实值后启动服务
# 注意：.env 不应提交到 Git

# OpenAI API 配置
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# AI 助手加密密钥（用于加密存储在数据库中的 OpenAI API Key）
# 可使用以下命令生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASSISTANT_ENCRYPTION_KEY=your-32-byte-base64-encoded-encryption-key-here

# AI 助手调用限制
ASSISTANT_MAX_MESSAGES_PER_SESSION=50
ASSISTANT_MAX_WRITE_ACTIONS_PER_SESSION=30

# 待确认操作令牌过期时间（秒）
ASSISTANT_CONFIRMATION_TTL_SECONDS=300
