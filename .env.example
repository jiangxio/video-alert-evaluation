# AI 助手配置
# 复制本文件为 .env 并填入真实值后启动服务
# 注意：.env 不应提交到 Git

# OpenAI API 配置
# 供 AI 助手、自动标注、智能审查（多模态）共用。兼容 OpenAI 协议的端点均可。
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Claude API 配置（报告生成用）
ANTHROPIC_AUTH_TOKEN=sk-ant-your-anthropic-token-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# AI 助手加密密钥（用于加密存储在数据库中的 OpenAI API Key）
# 可使用以下命令生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASSISTANT_ENCRYPTION_KEY=your-32-byte-base64-encoded-encryption-key-here

# AI 助手调用限制
ASSISTANT_MAX_MESSAGES_PER_SESSION=50
ASSISTANT_MAX_WRITE_ACTIONS_PER_SESSION=30

# 待确认操作令牌过期时间（秒）
ASSISTANT_CONFIRMATION_TTL_SECONDS=300

# AIBOX 边缘盒子配置（推流脚本 stream_fight_loop.py / stream_merged_sources.py 用）
# 真值放 .env，勿入库。留空=不预填，需显式传 --aibox-url/--aibox-user/--aibox-pass 或设环境变量。
AIBOX_URL=
AIBOX_USER=
AIBOX_PASS=
