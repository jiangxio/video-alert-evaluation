# AI 助手配置
# 复制本文件为 .env 并填入真实值后启动服务
# 注意：.env 不应提交到 Git
#
# ── Docker 部署 ──────────────────────────────────────────
# Docker 部署时 .env 是唯一需修改的配置文件：
#   cp .env.example .env   # 编辑填入 API key
#   docker compose up -d   # 一键启动，访问 http://localhost:8080
# ─────────────────────────────────────────────────────────

# 文本逻辑组（OpenAI 兼容协议）
# 供 AI 助手、评测报告生成（总结/结论/对话改写）使用。
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 多模态审查组（OpenAI 兼容协议）
# 供智能审查、自动标注使用，需支持图片输入的 VL 模型。未填写时回退文本逻辑组。
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=Qwen3-VL-8B-Instruct

# AI 助手加密密钥（用于加密存储在数据库中的 OpenAI API Key）
# 可使用以下命令生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASSISTANT_ENCRYPTION_KEY=your-32-byte-base64-encoded-encryption-key-here

# AI 助手调用限制
ASSISTANT_MAX_MESSAGES_PER_SESSION=50
ASSISTANT_MAX_WRITE_ACTIONS_PER_SESSION=30

# 待确认操作令牌过期时间（秒）
ASSISTANT_CONFIRMATION_TTL_SECONDS=300
